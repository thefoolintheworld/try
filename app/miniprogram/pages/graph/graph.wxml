<!--pages/graph/graph.wxml-->
<!-- P2-8 关联图谱：静态同心环布局（中心=总成就 / 内环=分类 / 外环=作者）。
     用 canvas 2D 一次性绘制，不做力导向动画（求稳，避开手势与重绘性能陷阱）。 -->
<navigation-bar title="关系图谱" back="{{true}}" color="{{navColor}}" background="{{navBg}}"></navigation-bar>

<scroll-view class="page {{themeClass}}" scroll-y type="list">

  <!-- 空态：成就不足 5 条 -->
  <empty-state wx:if="{{!hasData}}" icon="🕸️" title="关系图谱正在生成" desc="{{emptyHint}}" />

  <!-- 正常态：图谱 + 图例 -->
  <block wx:else>
    <view class="hero">
      <view class="hero-title">阅读关系图谱</view>
      <view class="hero-sub">中心是你的全部成就，向内是分类，向外是作者 —— 看看谁在你的阅读宇宙里发光</view>
    </view>

    <!-- 绘制失败：显示重试入口（而非永久空白） -->
    <empty-state wx:if="{{canvasState === 'failed'}}" icon="🕸️" title="图谱加载失败" desc="绘图组件未就绪，点下方按钮重试" btnText="重新加载" bind:btntap="onRetryCanvas" />

    <!-- 绘制中 / 完成：canvas + loading 蒙层 -->
    <block wx:else>
      <!-- canvas 容器：居中 -->
      <view class="canvas-wrap" style="width:{{canvasW}}px;height:{{canvasH}}px;">
        <canvas
          id="graph-canvas"
          type="2d"
          style="width:{{canvasW}}px;height:{{canvasH}}px;"
          bindtap="onCanvasTap"
        ></canvas>

        <!-- loading 蒙层：canvas 节点就绪/绘制期间盖在上面，避免空白洞 -->
        <view class="canvas-loading" wx:if="{{canvasState === 'drawing'}}">
          <view class="canvas-loading-spinner"></view>
          <text class="canvas-loading-text">正在生成关系图谱…</text>
        </view>
      </view>

      <view class="tip">点击节点可查看详情</view>

      <!-- 图例：分类配色说明 -->
      <view class="legend" wx:if="{{legend.length > 0}}">
        <view class="legend-title">分类构成</view>
        <view class="legend-grid">
          <view class="legend-item" wx:for="{{legend}}" wx:key="label">
            <view class="legend-dot" style="background:{{item.color}};"></view>
            <text class="legend-label">{{item.label}}</text>
            <text class="legend-count">{{item.count}}</text>
          </view>
        </view>
      </view>

      <view class="footer-tip">— 数据来自你的本地记录 —</view>
    </block>
  </block>

</scroll-view>
